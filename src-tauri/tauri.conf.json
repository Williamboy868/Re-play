{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "re-play",
  "version": "1.1.4",
  "identifier": "com.williams.re-play",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "re-play",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/yt-dlp",
      "bin/quickjs"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Williamboy868/Re-play/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGMTAwRkU2QURBNzNFNTYKUldSV1BxZXQ1ZzhRZjdlU0RGMXJOQkIybjNjMXBJOFR4NHZCc3oxOGErdzh4WjVmdG9VZE9FdGQK"
    }
  }
}
